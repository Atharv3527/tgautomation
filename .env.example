# Telegram API Credentials
# Get your API_ID and API_HASH from https://my.telegram.org (under 'API development tools')
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Your phone number with country code (e.g., +1234567890)
TELEGRAM_PHONE=

# Telethon session name (saved locally as <session_name>.session)
TELEGRAM_SESSION=telegram_automation

# Bot username to send links to
BOT_USERNAME=@save_restricted_contentpro_bot

# WhatsApp Webhook Verification Token (set this in Meta App Dashboard -> WhatsApp -> Configuration -> Webhook)
HUB_VERIFY_TOKEN=

# WhatsApp Cloud API Outbound Messaging (Optional: to send command responses back to WhatsApp users)
# Get from Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
